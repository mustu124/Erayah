{
  "name": "erayah-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "node scripts/supabase-db.mjs db push",
    "db:types": "node scripts/supabase-db.mjs gen types typescript --schema public > src/lib/supabase/types.ts && pnpm dlx prettier@3 --log-level warn --print-width 120 --write src/lib/supabase/types.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:e2e": "playwright test",
    "db:types:local": "tsx scripts/gen-db-types.ts",
    "import:images": "tsx --env-file=.env.local scripts/import-images.ts",
    "test:db": "node supabase/tests/checkout.test.mjs",
    "db:migrations": "node scripts/supabase-db.mjs migration list",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^62.2.0"
  },
  "packageManager": "pnpm@10.34.5"
}
