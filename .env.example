# Erayah — environment variables
# Copy to .env.local and fill in. Every variable is required: `pnpm dev` and
# `pnpm build` stop with a list of anything missing (src/lib/env/schema.ts).
# NEXT_PUBLIC_* values are sent to the browser. Everything else stays on the server.

# ── Site ───────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 · Production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ───────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys (use rzp_test_… until launch)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_
# Secret.
RAZORPAY_KEY_SECRET=
# Secret. Dashboard → Webhooks → the secret you set on the webhook.
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# resend.com → API Keys. Secret.
RESEND_API_KEY=re_
# Sender for invoices; the domain must be verified in Resend.
ORDER_EMAIL_FROM="Erayah <orders@your-domain.com>"
# Where new-order notifications go.
OWNER_NOTIFICATION_EMAIL=

# ── Social ─────────────────────────────────────────────────────────────────
# Digits only, with country code, no + or spaces (used in wa.me links).
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/<handle>/
